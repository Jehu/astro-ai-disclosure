---
/**
 * "AI" badge with a content-credentials popover for one image.
 *
 * Renders nothing when `credentials` is null, so a real photo can never be
 * labelled AI by accident. Place it inside a `position: relative` wrapper
 * around the image; the popover covers the image area.
 *
 * Self-contained: toggling uses a tiny inline script (no Alpine or other
 * runtime required). All copy comes in through `labels`, so i18n stays in
 * the project. Colours and radii read the project's custom properties
 * (`--ai-badge-*`) with neutral fallbacks.
 */
import type { AiCredentials } from '@jehu/astro-ai-disclosure/credentials';
import { formatCreatedAt } from '@jehu/astro-ai-disclosure/credentials';

export interface AiBadgeLabels {
  /** Button aria-label, e.g. "Inhaltsnachweise anzeigen". */
  open: string;
  /** Popover title, e.g. "Inhaltsnachweise". */
  title: string;
  /** Close button aria-label. */
  close: string;
  /** Intro sentence explaining that the image is AI-generated. */
  intro: string;
  /** Row label for the creator, e.g. "Erstellt mit". */
  createdWith: string;
  /** Row label for the date, e.g. "Erstellt am". */
  createdOn: string;
  /** Footer, e.g. the legal basis of the disclosure. */
  footer?: string;
}

interface Props {
  credentials: AiCredentials | null;
  labels: AiBadgeLabels;
  /** Locale for the date, defaults to de-DE. */
  locale?: string;
  /** Badge text, defaults to "AI". */
  mark?: string;
}

const { credentials, labels, locale = 'de-DE', mark = 'AI' } = Astro.props;
const createdOn = formatCreatedAt(credentials?.createdAt, locale);
const id = `ai-badge-${Math.random().toString(36).slice(2, 9)}`;
---

{
  credentials && (
    <div class="ai-badge" data-ai-badge>
      <button
        type="button"
        class="ai-badge__button"
        aria-label={labels.open}
        aria-haspopup="dialog"
        aria-controls={id}
        aria-expanded="false"
        data-ai-badge-toggle
      >
        <span aria-hidden="true">{mark}</span>
      </button>

      <div class="ai-badge__popover" id={id} role="dialog" aria-modal="false" aria-label={labels.title} hidden>
        <div class="ai-badge__head">
          <h3 class="ai-badge__title">{labels.title}</h3>
          <button type="button" class="ai-badge__close" aria-label={labels.close} data-ai-badge-close>
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </button>
        </div>

        <p class="ai-badge__intro">{labels.intro}</p>

        {(credentials.creator || createdOn) && (
          <dl class="ai-badge__list">
            {credentials.creator && (
              <>
                <dt>{labels.createdWith}</dt>
                <dd>{credentials.creator}</dd>
              </>
            )}
            {createdOn && (
              <>
                <dt>{labels.createdOn}</dt>
                <dd>{createdOn}</dd>
              </>
            )}
          </dl>
        )}

        {labels.footer && <p class="ai-badge__foot">{labels.footer}</p>}
      </div>
    </div>
  )
}

<script>
  const setOpen = (badge: HTMLElement, open: boolean) => {
    const trigger = badge.querySelector<HTMLButtonElement>('[data-ai-badge-toggle]');
    const popover = badge.querySelector<HTMLElement>('.ai-badge__popover');
    const restoreFocus = popover?.contains(document.activeElement);
    trigger?.setAttribute('aria-expanded', String(open));
    if (popover) {
      popover.hidden = !open;
      if (open) popover.querySelector<HTMLButtonElement>('[data-ai-badge-close]')?.focus();
      else if (restoreFocus) trigger?.focus();
    }
  };
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const badge = target?.closest<HTMLElement>('[data-ai-badge]');
    if (target?.closest('[data-ai-badge-toggle]') && badge) {
      const open = badge.querySelector<HTMLElement>('.ai-badge__popover')?.hidden ?? true;
      document.querySelectorAll<HTMLElement>('[data-ai-badge]').forEach((other) => setOpen(other, false));
      setOpen(badge, open);
      return;
    }
    if (target?.closest('[data-ai-badge-close]') && badge) {
      setOpen(badge, false);
      return;
    }
    if (!badge) document.querySelectorAll<HTMLElement>('[data-ai-badge]').forEach((other) => setOpen(other, false));
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      document.querySelectorAll<HTMLElement>('[data-ai-badge]').forEach((other) => setOpen(other, false));
    }
  });
</script>

<style>
  .ai-badge__button {
    position: absolute;
    top: var(--ai-badge-offset, 0.5rem);
    left: var(--ai-badge-offset, 0.5rem);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.375rem;
    height: 1.375rem;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.35);
    color: #fff;
    font: 700 0.6875rem/1 var(--ai-badge-font, system-ui, sans-serif);
    letter-spacing: 0.03em;
    cursor: pointer;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .ai-badge__button:hover,
  .ai-badge__button:focus-visible {
    background: rgba(255, 255, 255, 0.7);
    border-color: rgba(255, 255, 255, 0.85);
    color: var(--ai-badge-text, #1f2320);
  }

  .ai-badge__button:focus-visible {
    outline: 2px solid var(--ai-badge-text, #1f2320);
    outline-offset: 2px;
  }

  .ai-badge__popover {
    position: absolute;
    inset: var(--ai-badge-offset, 0.5rem);
    z-index: 20;
    padding: 0.875rem 1rem 1rem;
    overflow-y: auto;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: var(--ai-badge-radius, 0.5rem);
    background: rgba(255, 255, 255, 0.97);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    color: var(--ai-badge-text, #1f2320);
    font: 0.75rem/1.45 var(--ai-badge-font, system-ui, sans-serif);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .ai-badge__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .ai-badge__title {
    margin: 0;
    font: 400 1rem/1.2 var(--ai-badge-title-font, var(--ai-badge-font, system-ui, sans-serif));
  }

  .ai-badge__close {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: none;
    background: transparent;
    color: inherit;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.15s ease;
  }

  .ai-badge__close:hover,
  .ai-badge__close:focus-visible {
    opacity: 1;
  }

  .ai-badge__close svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ai-badge__intro {
    margin: 0 0 0.875rem;
    opacity: 0.85;
  }

  .ai-badge__list {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 0.75rem;
    row-gap: 0.375rem;
    margin: 0 0 0.875rem;
  }

  .ai-badge__list dt {
    font-weight: 600;
    opacity: 0.7;
  }

  .ai-badge__list dd {
    margin: 0;
  }

  .ai-badge__foot {
    margin: 0;
    opacity: 0.6;
  }
</style>
